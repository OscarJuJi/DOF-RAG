# Previous repository metadata retained locally during monorepo migration.
**/.git-history-backup/

# Secrets and local environments.
**/.env
**/.env.*
!**/.env.example
**/.venv/

# Generated artifacts.
**/node_modules/
**/dist/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ipynb_checkpoints/

# Local production data and additional source documents.
/documents/*
!/documents/README.md
/data/
**/*.sqlite3*
**/.test-results/
